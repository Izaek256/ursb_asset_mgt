# Backend API URL — change port to whichever is free on your machine (8000, 8001, or 8002)
VITE_API_BASE_URL=http://localhost:8001

# Port the backend (FastAPI/uvicorn) is running on — must match VITE_API_BASE_URL above
# Also used for direct WebSocket connections (ws://host:PORT/...)
VITE_BACKEND_PORT=8001

# Port the Vite dev server listens on
VITE_DEV_PORT=5173
